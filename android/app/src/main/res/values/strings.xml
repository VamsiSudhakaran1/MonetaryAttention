    <!-- Settings: long descriptions -->
    <string name="desc_currency">Auto-detected from your region. Values are regional estimates.</string>
    <string name="desc_hard_truth">Stronger wording on your receipt and notification. The numbers never change.</string>
    <string name="desc_quirky">Cheeky, funnier wording. Overrides hard truth.</string>
    <string name="desc_adfree">Pay for Premium (YouTube, X, …)? Mark it ad-free. We keep showing your time but stop estimating ad value for it.</string>
    <string name="desc_auto_ad">Opt-in. Counts real “Sponsored” labels on-device in supported apps so your estimates become actual ad counts — great for Reels. Reads only ad markers, stores only counts, and you can turn it off anytime in Accessibility settings.</string>
    <string name="btn_open_accessibility">Open Accessibility settings</string>
    <string name="desc_calibrate">Saw an ad? Tap the app below. After ~15 minutes on a platform your real ad frequency replaces our default estimate. Nothing leaves your device.</string>
    <string name="recorded_ad">Recorded an ad for %1$s</string>
    <string name="lbl_plus_ad">+ ad</string>
    <string name="desc_calibrate_tile">Prefer a shortcut? Add the “I saw an ad” Quick Settings tile so you can tap it without opening the app.</string>
    <string name="btn_add_tile">Add Quick Settings tile</string>
    <string name="desc_how_estimate">We read only aggregate app usage time — never screen content, messages, or ads themselves. Value is a transparent estimate from typical ad load and CPM ranges, shown as a range to stay honest.</string>

